# Cloudflare Pages headers.

# Résumé: linked from the site, but kept out of search indexes.
/resume/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=3600

# Long-cache immutable, fingerprinted build assets.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Site-wide security headers. The site makes zero external runtime requests,
# so a strict self-only CSP holds (fitting for a security portfolio).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), interest-cohort=()
  X-Frame-Options: DENY
